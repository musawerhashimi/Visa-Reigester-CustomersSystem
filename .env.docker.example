# Backend environment for `docker compose up`.
#   cp .env.docker.example .env      then set a real DJANGO_SECRET_KEY
#
# Only the backend reads this file. The frontend's configuration is baked into
# its bundle at build time through the build args in docker-compose.yml.

# --- Core -------------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=generate-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database and channel layer ---------------------------------------------
# docker-compose sets DATABASE_URL and REDIS_URL itself, pointing at the db and
# redis services. Both are listed here only so the file documents them.
# DATABASE_URL=postgres://visacrm:visacrm@db:5432/visacrm
# REDIS_URL=redis://redis:6379/0

# Used by docker-compose to create the Postgres role and database.
POSTGRES_DB=visacrm
POSTGRES_USER=visacrm
POSTGRES_PASSWORD=visacrm

# --- Origins ----------------------------------------------------------------
# The frontend is served on 8080 by compose, so that is what may call the API.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Where the customer-facing site lives, used for links inside emails.
SITE_URL=http://localhost:8080

# --- Email ------------------------------------------------------------------
# The console backend prints mail to the logs instead of sending it, which is
# what you want locally. Real SMTP is configured in the MIS, not here.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
COMPANY_NOTIFICATION_EMAIL=office@example.com

# --- Optional ---------------------------------------------------------------
TIME_ZONE=Europe/Berlin
APPLICATION_NUMBER_PREFIX=VISA
RECEIPT_NUMBER_PREFIX=RCPT
MAX_UPLOAD_SIZE_BYTES=10485760

# Set both to have the container create a superuser on first boot.
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=
