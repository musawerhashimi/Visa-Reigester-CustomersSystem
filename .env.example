# Copy to .env and fill in. Never commit the real .env.

DJANGO_SECRET_KEY=generate-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave POSTGRES_DB unset to develop against SQLite.
POSTGRES_DB=visacrm
POSTGRES_USER=visacrm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173
TIME_ZONE=Europe/Berlin

# Console backend prints emails to the terminal instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
COMPANY_NOTIFICATION_EMAIL=office@example.com

APPLICATION_NUMBER_PREFIX=VISA
RECEIPT_NUMBER_PREFIX=RCPT
MAX_UPLOAD_SIZE_BYTES=10485760

VITE_API_BASE_URL=http://localhost:8000/api
